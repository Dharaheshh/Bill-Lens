DATABASE_URL=postgresql+psycopg://billlens:billlens@localhost:5433/billlens

# ── LLM Primary (chat, tool calls, agents) ────────────────────────────
# For Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_groq_key_here
#   LLM_MODEL_AGENT=llama-3.3-70b-versatile
#   LLM_MODEL_FAST=llama-3.1-8b-instant
# For OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-your_openai_key_here
#   LLM_MODEL_AGENT=gpt-4o-mini
#   LLM_MODEL_FAST=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_FAST=

# ── Vision (bill image extraction) ────────────────────────────────────
# Groq does not support vision. If primary is Groq, set a separate
# vision provider here (e.g. OpenAI). If blank, vision uses the primary.
#   LLM_VISION_BASE_URL=https://api.openai.com/v1
#   LLM_VISION_API_KEY=sk-your_openai_key_here
LLM_MODEL_VISION=gpt-4o
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# ── LLM Fallback ──────────────────────────────────────────────────────
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── Other ─────────────────────────────────────────────────────────────
LLM_CACHE_MODE=readwrite
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
FASTEMBED_CACHE_PATH=./fastembed_cache
PRICE_VARIANCE_FACTOR=1.5
ESTIMATE_VARIANCE_FACTOR=1.2
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STORAGE_DIR=./storage
REPLAY_MAX_GAP_MS=1200
